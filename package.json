{
  "name": "taskmark-taskmark",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Taskmark board \u2014 npm start / npx taskmark serve (local), or Vercel static hosting via npm run build.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "taskmark serve --no-open",
    "serve": "taskmark serve",
    "dev": "taskmark dev",
    "build": "taskmark build --board . --out out",
    "preview": "taskmark preview"
  },
  "dependencies": {
    "@taskmark/ui": "1.2.0"
  },
  "taskmark": {
    "writingLanguage": "English"
  }
}
